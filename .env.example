# Copy to .env (root). Both apps read this one file.

# --- Server ---
# Port the Colyseus game server listens on.
PORT=2567
# Production only (see README → Deploying): Postgres copy of the saves, and the frontend origin(s).
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
# ALLOWED_ORIGINS=https://homebound.pages.dev

# --- Client (Vite: only VITE_* vars reach the browser, never put secrets here) ---
# Game server URL. Leave empty in dev: the client uses the same host it was opened from,
# port 2567, so Machine B opening http://<lan-ip>:5173 reaches the server on Machine A.
# Production example: https://homebound-server.example.com
VITE_SERVER_URL=
