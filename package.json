{
  "name": "homebound-wild-world",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "apps/server",
    "apps/client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build -w @homebound/shared && node scripts/dev.mjs",
    "build": "npm run build --workspaces",
    "start": "npm run start -w @homebound/server",
    "test": "npm run build -w @homebound/shared && vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "node scripts/e2e/run.mjs",
    "deploy": "node scripts/deploy.mjs",
    "typecheck": "npm run build -w @homebound/shared && tsc -p packages/shared/tsconfig.test.json && tsc -p apps/server/tsconfig.test.json && tsc -b apps/client"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "playwright-core": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
